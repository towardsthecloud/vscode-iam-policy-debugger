{
  "name": "iam-policy-debugger",
  "displayName": "AWS IAM Policy Debugger",
  "description": "Validate AWS IAM policies, debug access decisions and run regression scenarios in VS Code.",
  "author": "Danny Steenman",
  "version": "0.1.1",
  "publisher": "dannysteenman",
  "homepage": "https://towardsthecloud.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/towardsthecloud/vscode-iam-policy-debugger.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#2B2C33",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "Testing",
    "Linters"
  ],
  "keywords": [
    "aws",
    "iam",
    "policy",
    "debugger",
    "validator",
    "testing",
    "security"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.iam-tests.json"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc --noEmit && node scripts/build.cjs",
    "watch": "node scripts/build.cjs --watch",
    "test": "npm run test:integration",
    "test:integration": "npm run package && node scripts/test-vscode.cjs",
    "package": "vsce package --no-dependencies --out .vscode-test/iam-policy-debugger.vsix",
    "vscode:prepublish": "npm run compile",
    "test:cli": "node --test tests/cli.test.cjs",
    "test:scenarios": "node out/cli.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "iamPolicyDebugger.debugPolicy",
        "title": "IAM: Debug Access for Current Policy"
      },
      {
        "command": "iamPolicyDebugger.runScenarios",
        "title": "IAM: Run Scenarios in Current File"
      },
      {
        "command": "iamPolicyDebugger.refreshTests",
        "title": "IAM: Refresh Policy Scenarios"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "iamPolicyDebugger.debugPolicy",
          "when": "resourceExtname =~ /\\.(json|ya?ml|tf)$/ && resourceFilename !~ /\\.iam-tests\\.json$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "iamPolicyDebugger.debugPolicy",
          "when": "resourceExtname =~ /\\.(json|ya?ml|tf)$/ && resourceFilename !~ /\\.iam-tests\\.json$/",
          "group": "iam"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.iam-tests.json",
        "url": "./schemas/iam-tests.schema.json"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/towardsthecloud/vscode-iam-policy-debugger/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Policy debugging and saved scenarios require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "dependencies": {
    "@actsecurity/iam-data": "0.21.202610101",
    "@cdktf/hcl2json": "0.21.0",
    "ipaddr.js": "2.5.0",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "icon": "images/iam-policy-debugger-extension-icon.png",
  "bin": {
    "iam-policy-tests": "out/cli.cjs"
  }
}
